  "radii": {
    "_comment": "Border radii in px.  --radius: 0.5rem base; sm/md/lg/xl are the shadcn named stops.",
    "sm":   4,
    "md":   6,
    "lg":   8,
    "xl":   12,
    "full": 9999
  },

  "spacing": {
    "_comment": "4 px base grid.  Values are px.",
    "scale": [4, 8, 12, 16, 24, 32, 48]
  },

  "typography": {
    "fontStack": ["Inter", "Noto Sans", "DejaVu Sans", "sans-serif"],
    "sizes": {
      "_comment": "Font sizes in px.",
      "xs":   12,
      "sm":   14,
      "base": 16,
      "lg":   18,
      "xl":   20,
      "2xl":  24,
      "3xl":  30
    },
    "weights": {
      "_comment": "CSS numeric font weights.",
      "normal": 400,
      "medium": 500,
      "semibold": 600
    },
    "headingLetterSpacing": -0.4
  },

  "shadows": {
    "_comment": "Box shadows matching tailwind's sm/md/lg stops, used by cards, dialogs, active tab triggers.",
    "sm": "0 1px 2px rgba(0,0,0,.05)",
    "md": "0 4px 6px -1px rgba(0,0,0,.1)",
    "lg": "0 10px 15px -3px rgba(0,0,0,.1)"
  },

  "motion": {
    "_comment": "Transition durations in ms.  Easing: OutQuad for colour, instant for focus ring.",
