            "x": 830,
            "y": 160,
            "width": 116,
            "height": 390
          },
          "properties": {
            "value": 60.0,
            "minimumValue": 0.0,
            "maximumValue": 100.0,
            "topLabel": "FULL",
            "midLabel": "1/2",
            "bottomLabel": "EMPTY",
            "redZone": "low",
