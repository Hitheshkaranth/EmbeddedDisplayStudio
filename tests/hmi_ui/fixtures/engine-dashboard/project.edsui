{
  "version": 1,
  "name": "engine-dashboard",
  "screen": {
    "width": 1024,
    "height": 768,
    "background": "#101418",
    "theme": "dark"
  },
  "pages": [
    {
      "id": "main",
      "name": "Main",
      "widgets": [
        {
          "type": "ShClusterGauge",
          "id": "rpmGauge",
          "geometry": {
            "x": 260,
            "y": 30,
            "width": 520,
            "height": 520
          },
          "properties": {
            "label": "RPM",
            "readout": "3200",
            "readoutUnit": "RPM",
            "caption": "",
            "value": 3.5,
            "minimumValue": 0.0,
            "maximumValue": 8.0,
            "redlineFrom": 7.0,
            "sweep": 240.0,
            "decimals": 0,
            "showInnerDial": true
          },
          "bindings": {
            "value": {
              "tag": "eng.rpm",
              "format": "",
              "multiplier": 1.0,
              "offset": 0.0,
              "unit": "RPM",
              "warning": "> 6.5",
              "critical": "> 7.5"
            }
          },
          "children": [],
          "locked": false,
          "z": 0
        },
        {
          "type": "ShAutoLevel",
          "id": "coolantGauge",
          "geometry": {
            "x": 80,
            "y": 80,
            "width": 120,
            "height": 220
          },
          "properties": {
            "value": 85.0,
            "minimumValue": 0.0,
            "maximumValue": 120.0,
            "topLabel": "HOT",
            "midLabel": "NORM",
            "bottomLabel": "COLD",
            "redZone": "high",
            "redZoneSpan": 15.0,
            "icon": "temperature",
            "curved": false,
            "showTicks": true
          },
          "bindings": {
            "value": {
              "tag": "eng.coolant_c",
              "format": "",
              "multiplier": 1.0,
              "offset": 0.0,
              "unit": "°C",
              "warning": "> 95",
              "critical": "> 105"
            }
          },
          "children": [],
          "locked": false,
          "z": 0
        },
        {
          "type": "ShAutoLevel",
          "id": "oilGauge",
          "geometry": {
            "x": 50,
            "y": 340,
            "width": 160,
            "height": 255
          },
          "properties": {
            "value": 45.0,
            "minimumValue": 0.0,
            "maximumValue": 120.0,
            "topLabel": "HOT",
            "midLabel": "NORM",
            "bottomLabel": "COLD",
            "redZone": "high",
