            "x": 340,
            "y": 545,
            "width": 140,
            "height": 60
          },
          "properties": {
            "text": "START"
          },
          "bindings": {},
          "children": [],
          "locked": false,
          "z": 0,
          "actions": {
            "clicked": {
              "kind": "write",
              "tag": "do.engine_start",
              "value": true
