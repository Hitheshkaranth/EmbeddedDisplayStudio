        {"type": "ShEngineBar", "id": "oil", "properties": {"label": "Oil", "units": "°C", "value": 76,
         "maximumValue": 120, "cautionValue": 100, "warningValue": 110}, "bindings": {"value": {"tag": "truck.oil_c"}}},
        {"type": "ShEngineBar", "id": "trans", "properties": {"label": "Trans", "units": "°C", "value": 45,
         "maximumValue": 120, "cautionValue": 95, "warningValue": 105}, "bindings": {"value": {"tag": "truck.trans_c"}}}]}
    ]
  }]
}
