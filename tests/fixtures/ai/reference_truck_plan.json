        {"type": "ShDataField", "id": "rollLive", "properties": {"label": "Roll", "value": "0.5°"},
         "bindings": {"value": {"tag": "truck.roll"}}}]},
      {"title": "RPM", "role": "instruments", "region": "bottom", "accent": "#f97316", "widgets": [
        {"type": "ShClusterGauge", "id": "rpm", "properties": {"caption": "RPM", "label": "x1000",
