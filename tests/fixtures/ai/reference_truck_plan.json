         "bindings": {"frontLeft": {"tag": "truck.tire_fl"}, "frontRight": {"tag": "truck.tire_fr"},
                      "rearLeft": {"tag": "truck.tire_rl"}, "rearRight": {"tag": "truck.tire_rr"}}}]},
      {"title": "Fuel", "role": "readings", "region": "right", "widgets": [
        {"type": "ShSegmentBar", "id": "fuel", "properties": {"label": "Fuel", "value": 78, "showPercent": true},
