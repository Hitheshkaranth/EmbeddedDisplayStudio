         "bindings": {"value": {"tag": "truck.payload_t"}}}]},
      {"title": "Incline", "role": "instruments", "region": "right", "widgets": [
        {"type": "ShCompass", "id": "heading", "properties": {"heading": 12},
         "bindings": {"heading": {"tag": "truck.heading"}}},
        {"type": "ShAttitude", "id": "attitude", "properties": {"pitch": 3, "roll": 1},
         "bindings": {"pitch": {"tag": "truck.pitch"}, "roll": {"tag": "truck.roll"}}}]},
      {"title": "Tires", "role": "readings", "region": "right", "widgets": [
        {"type": "ShVehicleStatus", "id": "tires", "properties": {"label": "PSI", "unit": "psi",
