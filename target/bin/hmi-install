#!/bin/sh
# /usr/bin/hmi-install
# =====================================================================
# HMI Atomic Bundle Installer
# =====================================================================
#
# PURPOSE
#   Target-side installer for BYOA HMI application bundles.  Implements
#   CONTRACT section 6: unpack, validate, atomically swap, verify, and
#   self-rollback if the GUI fails to come up.
#
# USAGE
#   hmi-install install <bundle.tar.gz>
#   hmi-install rollback
#   hmi-install activate <release-name>
#   hmi-install list
#   hmi-install status
#   hmi-install help
#
# EXIT CODES
#   0  -- success
#   1  -- general / validation error
#   2  -- usage error
#   3  -- locked (another install is running)
#
# MACHINE-READABLE OUTPUT
#   Every step prints a line:  STEP <tag> <ok|fail> [detail]
#   Tags are stable across versions; two other agents parse them.
#   See target/README.md for the full vocabulary.
#
# ENVIRONMENT
#   HMI_ROOT          -- path prefix for all fs paths (empty in prod)
#   HMI_RESTART_CMD   -- override for `systemctl restart hmi-gui.service`
#                        (for off-target testing without systemd)
#   HMI_ENABLE_CMD    -- override for `systemctl enable hmi-gui.service`,
#                        the step that makes the app the boot default
#   HMI_SKIP_GUI_WAIT -- if set to "1", skip waiting for gui-ready and
#                        skip enabling autostart (for off-target testing)
#
# SAFETY
#   The script uses flock(2) to serialise concurrent invocations.
#   The `current` symlink is swapped atomically via a python3
#   os.replace() call on a temporary symlink.  rm-then-ln and ln -sfnT
#   are deliberately avoided; see the swap_current_symlink function.
#
# =====================================================================

set -eu

# ---- Globals ---------------------------------------------------------
# Every global is annotated with its purpose and what breaks without it.

# HMI_ROOT: filesystem prefix for off-target testing.
# In production this is always empty; every absolute path in the script
# is written as "${HMI_ROOT}/real/path" so the whole tree can be
# relocated into a temp directory on a dev host.
HMI_ROOT="${HMI_ROOT:-}"

# Base directory for all HMI application releases.
# Contains releases/<name>/, the `current` symlink, and the `previous`
# symlink.  Without this variable the script has no target for installs.
APPS_BASE="${HMI_ROOT}/opt/hmi_apps"

# Directory where individual release directories live.
RELEASES_DIR="${APPS_BASE}/releases"

# Symlink pointing to the active release.  The GUI loader reads this.
CURRENT_LINK="${APPS_BASE}/current"

# Symlink pointing to the release that was active before the last install.
# Used by the rollback subcommand and automatic rollback on GUI failure.
PREVIOUS_LINK="${APPS_BASE}/previous"

# Upload landing zone.  Bundles are only accepted from this directory
# to limit exposure when hmi-install is used as a forced SSH command.
UPLOAD_DIR="${HMI_ROOT}/tmp/hmi_upload"

# Runtime directory on tmpfs for locks and sentinels.
RUN_DIR="${HMI_ROOT}/run/hmi"

# Flock file preventing concurrent installs.
LOCK_FILE="${RUN_DIR}/install.lock"

# Readiness sentinel created by the GUI loader once the UI is live.
READY_FILE="${RUN_DIR}/gui-ready"

# How long (seconds) to wait for the GUI to signal readiness after a
# restart.  If the GUI is not ready by this deadline the install is
# considered failed and the previous release is restored.
GUI_READY_TIMEOUT=25

# Maximum acceptable bundle size in bytes (500 MB).  Reject anything
# larger to prevent filling the rootfs.  Adjust if bundles are
# legitimately larger.
MAX_BUNDLE_SIZE=524288000

# Command used to restart the GUI service.  Overridable for off-target
# testing where systemd is unavailable.
HMI_RESTART_CMD="${HMI_RESTART_CMD:-systemctl restart hmi-gui.service}"

# Command that makes the GUI start at boot.  A deploy that only restarts the
# service leaves a panel that shows the application now and nothing at all
# after the next power cycle, which on a machine that is normally power-cycled
# rather than shut down is the only state that matters.  `systemctl enable` is
# idempotent, so running it on every install costs nothing and removes the
# assumption that somebody enabled the unit by hand once.
HMI_ENABLE_CMD="${HMI_ENABLE_CMD:-systemctl enable hmi-gui.service}"

# When set to "1", skip waiting for the gui-ready file and skip
# restarting the GUI.  Used only in off-target testing.
HMI_SKIP_GUI_WAIT="${HMI_SKIP_GUI_WAIT:-0}"

# Number of historical releases to keep beyond `current` and `previous`.
# The pruning step keeps the 3 newest plus whatever current and previous
# point at.
KEEP_RELEASES=3

# Interpreter used for manifest validation, path canonicalisation and the
# atomic symlink swap.
#
# A bare `python3` is not safe to assume on a Yocto image: the stdlib is split
# into subpackages, and a base image can ship python3-core alone -- without
# json or tempfile, which every python step below needs. Provisioning can
# install a complete interpreter at /opt/hmi-python; prefer it when present.
#
# Resolution order: $HMI_PYTHON, then the provisioned interpreter, then PATH.
if [ -n "${HMI_PYTHON:-}" ] && [ -x "${HMI_PYTHON}" ]; then
    PYTHON="${HMI_PYTHON}"
elif [ -x "${HMI_ROOT}/opt/hmi-python/bin/python3" ]; then
    PYTHON="${HMI_ROOT}/opt/hmi-python/bin/python3"
else
    PYTHON="python3"
fi

# The single implementation of CONTRACT section 4 (schema/manifest.py).
#
# Two locations, checked in order, exactly as the GUI loader resolves its QML
# import path:
#   1. /usr/lib/hmi/manifest.py -- where provisioning and the Yocto recipe
#      install it on a real panel.
#   2. <this script>/../../schema/manifest.py -- the repository layout, so the
#      installer can be driven straight from a checkout in tests and in the
#      WSL stand-in panel without an install step.
_self_dir="$(dirname "$0")"
if [ -f "${HMI_ROOT}/usr/lib/hmi/manifest.py" ]; then
    VALIDATOR="${HMI_ROOT}/usr/lib/hmi/manifest.py"
elif [ -f "${_self_dir}/../../schema/manifest.py" ]; then
    VALIDATOR="${_self_dir}/../../schema/manifest.py"
else
    VALIDATOR="/usr/lib/hmi/manifest.py"
fi

# ---- Functions -------------------------------------------------------

##
# step -- emit a machine-readable step line plus optional human text
#
# Format: STEP <tag> <ok|fail> [detail]
# The tag is a stable identifier parsed by host-side deploy tools.
# The detail is free-form human text.
#
# Args:
#   $1  tag     -- step identifier (e.g. "verify-sha256")
#   $2  status  -- "ok" or "fail"
#   $*  detail  -- optional human-readable description
#
# Returns: 0
# Exits:   never
# Side effects: writes to stdout
##
step() {
    _tag="$1"; shift
    _stat="$1"; shift
    printf 'STEP %s %s %s\n' "$_tag" "$_stat" "$*"
}

##
# log -- emit a timestamped informational message to stderr
#
# Args:
#   $1  severity  -- "INFO", "WARN", or "ERROR"
#   $*  message   -- free-form text
#
# Returns: 0
# Exits:   never
# Side effects: writes to stderr
##
log() {
    _sev="$1"; shift
    printf '[hmi-install] %s: %s\n' "$_sev" "$*" >&2
}

##
# die -- log an error, emit a STEP fail line, and exit
#
# Args:
#   $1  exit_code  -- numeric exit code
#   $2  tag        -- step tag for the machine-readable line
#   $*  message    -- error description
#
# Returns: does not return
# Exits:   with $1
# Side effects: writes to stdout and stderr
##
die() {
    _rc="$1"; shift
    _tag="$1"; shift
    step "$_tag" "fail" "$*"
    log "ERROR" "$*"
    exit "$_rc"
}

##
# cleanup_upload_dir -- remove all files from the upload landing zone
#
# Wired to an EXIT trap (see the dispatch section) so it runs on every path,
# including every die().  It previously claimed to be "called on both success
# and failure" but was only ever called on the success path and on the
# rollback path: a checksum mismatch, a bad manifest or a failed extraction
# left its tarball behind.  UPLOAD_DIR is a tmpfs and MAX_BUNDLE_SIZE is
# 500 MB, so repeated failed deploys consumed RAM on a running machine.
#
# Args:   none
# Returns: 0
# Exits:   never
# Side effects: deletes all files under UPLOAD_DIR, and any staging directory
#               this process left behind
##
cleanup_upload_dir() {
    if [ -d "$UPLOAD_DIR" ]; then
        rm -rf "${UPLOAD_DIR:?}"/*
        log "INFO" "cleaned upload directory ${UPLOAD_DIR}"
    fi
}

##
# cleanup_on_exit -- EXIT trap: drop temporary state this process created
#
# Removes our own staging directory if it was never promoted, then empties the
# upload landing zone.  Only ever touches .stage.$$, which is named after this
# process, so it can never remove a promoted release or one that `current`
# points at.
#
# Args:   none
# Returns: 0 (the shell's exit status is preserved: a trap's status is ignored
#          unless it exits itself, which this does not)
# Exits:   never
# Side effects: deletes ${RELEASES_DIR}/.stage.$$ and the contents of UPLOAD_DIR
##
cleanup_on_exit() {
    if [ -d "${RELEASES_DIR}/.stage.$$" ]; then
        log "WARN" "removing unpromoted staging directory ${RELEASES_DIR}/.stage.$$"
        rm -rf "${RELEASES_DIR}/.stage.$$"
    fi
    cleanup_upload_dir
}

##
# validate_bundle_path -- verify the bundle path is safe to process
#
# Security checks:
#   1. The resolved (realpath) bundle must reside under UPLOAD_DIR.
#      This prevents path-traversal attacks when hmi-install is used
#      as a forced SSH command.
#   2. The path must not be a symbolic link (prevents symlink attacks
#      that could trick the script into reading outside UPLOAD_DIR).
#   3. The file size must be under MAX_BUNDLE_SIZE to prevent filling
#      the root filesystem.
#   4. The file must actually exist and be a regular file.
#
# Args:
#   $1  bundle_path  -- path to the bundle tarball
#
# Returns: 0 if valid
# Exits:   1 if any check fails
# Side effects: none
##
validate_bundle_path() {
    _bp="$1"

    # Must exist.
    if [ ! -e "$_bp" ]; then
        die 1 "validate-path" "bundle does not exist: ${_bp}"
    fi

    # Must be a regular file, not a symlink, device, directory, etc.
    if [ -L "$_bp" ]; then
        die 1 "validate-path" "bundle is a symbolic link (rejected for safety): ${_bp}"
    fi
    if [ ! -f "$_bp" ]; then
        die 1 "validate-path" "bundle is not a regular file: ${_bp}"
    fi

    # Resolve to an absolute path and verify it is under UPLOAD_DIR.
    # We use python3 because busybox `realpath` may not be available on
    # minimal Yocto images, and we need a reliable canonicalisation.
    _resolved=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$_bp")
    _upload_resolved=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$UPLOAD_DIR")

    case "$_resolved" in
        "${_upload_resolved}"/*)
            : # good -- path is under UPLOAD_DIR
            ;;
        *)
            die 1 "validate-path" "bundle path resolves outside upload dir: ${_resolved} is not under ${_upload_resolved}"
            ;;
    esac

    # Size check.
    _size=$(wc -c < "$_bp")
    if [ "$_size" -gt "$MAX_BUNDLE_SIZE" ]; then
        die 1 "validate-path" "bundle too large: ${_size} bytes (max ${MAX_BUNDLE_SIZE})"
    fi

    step "validate-path" "ok" "${_bp} (${_size} bytes)"
}

##
# verify_sha256 -- verify the SHA-256 sidecar checksum
#
# The sidecar file must be named <bundle>.sha256 and contain a single
# line in the format:  <hex-digest>  <filename>
# (two-space separator, as produced by sha256sum).
#
# Args:
#   $1  bundle_path  -- path to the bundle tarball
#
# Returns: 0 if checksum matches
# Exits:   1 if sidecar is missing or checksum does not match
# Side effects: none
##
verify_sha256() {
    _bp="$1"
    _sidecar="${_bp}.sha256"

    if [ ! -f "$_sidecar" ]; then
        die 1 "verify-sha256" "SHA-256 sidecar not found: ${_sidecar}"
    fi

    # Extract the expected digest from the sidecar.
    _expected=$(awk '{print $1}' "$_sidecar")
    if [ -z "$_expected" ]; then
        die 1 "verify-sha256" "sidecar is empty or malformed: ${_sidecar}"
    fi

    # Compute the actual digest.  sha256sum is provided by coreutils
    # on all Yocto images (busybox or full).
    _actual=$(sha256sum "$_bp" | awk '{print $1}')

    if [ "$_expected" != "$_actual" ]; then
        die 1 "verify-sha256" "checksum mismatch: expected=${_expected} actual=${_actual}"
    fi

    step "verify-sha256" "ok" "$_actual"
}

##
# prescan_bundle -- reject a hostile archive BEFORE anything is written
#
# Reads the member list without extracting and refuses absolute paths, ".."
# components, links whose targets escape the bundle root, and any member that
# is not a file, directory or link.
#
# This ordering is the whole point. The traversal check used to run after
# extraction, by walking the staging directory for ".." components -- which
# could never fire, because a member that escaped had by definition been
# written somewhere else and was not in the tree being walked. GNU tar refuses
# such members on its own, but busybox tar (which is what a minimal Yocto
# image ships) historically did not, and hmi-install is documented as safe to
# expose as a forced SSH command.
#
# Args:
#   $1  bundle_path  -- path to the bundle tarball
#
# Returns: 0 if every member is safe
# Exits:   1 on the first unsafe member, naming it
# Side effects: none -- nothing is written to disk
##
prescan_bundle() {
    _bp="$1"

    _result=$("$PYTHON" - "$_bp" <<'PYEOF'
import posixpath
import sys
import tarfile

bundle = sys.argv[1]


def is_absolute(path):
    """True if `path` is absolute in POSIX or Windows-drive form.

    Args:
        path: a member name or link target from the archive.
    """
    if not path:
        return False
    return path.startswith("/") or (len(path) > 1 and path[1] == ":")


def name_escapes(name):
    """True if a member NAME would be written outside the extraction dir.

    Args:
        name: the archive member name.

    A member name is rejected for any '..' component as well as for being
    absolute. Unlike a link target, there is no legitimate reason for a
    member's own name to walk upwards, so this does not need to normalise.
    """
    if is_absolute(name):
        return True
    return any(part == ".." for part in name.replace("\\", "/").split("/"))


def link_escapes(name, target):
    """True if a link would resolve outside the extraction directory.

    Args:
        name:   the link member's own name (its directory is the base).
        target: the link target as stored in the archive.

    '..' is legal in a link target -- `qml/theme.qml -> ../shared/theme.qml`
    is an ordinary thing for a bundle to contain -- so the target is resolved
    against the link's own directory and only rejected if the result leaves
    the bundle root. Rejecting every '..' outright refused valid bundles.
    """
    if is_absolute(target):
        return True
    resolved = posixpath.normpath(
        posixpath.join(posixpath.dirname(name.replace("\\", "/")),
                       target.replace("\\", "/"))
    )
    return resolved == ".." or resolved.startswith("../") or resolved.startswith("/")


try:
    with tarfile.open(bundle, "r:gz") as tar:
        for member in tar:
            if name_escapes(member.name):
                print("member escapes the bundle root: %s" % member.name)
                sys.exit(1)
            # A symlink or hardlink is followed by tar when a later member is
            # written through it, so the target has to be checked too.
            # A hardlink target names another archive member, so it is
            # resolved from the bundle root rather than the link's directory.
            if member.issym():
                if link_escapes(member.name, member.linkname):
                    print("link target escapes the bundle root: %s -> %s"
                          % (member.name, member.linkname))
                    sys.exit(1)
            elif member.islnk():
                if name_escapes(member.linkname):
                    print("hard link target escapes the bundle root: %s -> %s"
                          % (member.name, member.linkname))
                    sys.exit(1)
            # Device nodes, FIFOs and sockets have no place in an application
            # bundle and are a classic way to smuggle something past a review.
            if not (member.isfile() or member.isdir()
                    or member.issym() or member.islnk()):
                print("unsupported member type in bundle: %s" % member.name)
                sys.exit(1)
except tarfile.TarError as exc:
    print("bundle is not a readable gzip tarball: %s" % exc)
    sys.exit(1)

print("OK")
PYEOF
    ) || true

    # `|| true` so `set -e` does not kill the script the moment the helper
    # exits non-zero: the whole point of capturing its output is to report the
    # reason through die(), and an early exit loses both the STEP fail line and
    # the message. Same trap as the old `[ $? -ne 0 ]` check in
    # swap_current_symlink.
    if [ "$_result" != "OK" ]; then
        die 1 "prescan" "$_result"
    fi

    step "prescan" "ok" "no path traversal in archive members"
}

##
# extract_bundle -- extract the tarball into a private staging directory
#
# Sets the global STAGING_DIR.
#
# Args:
#   $1  bundle_path  -- path to the bundle tarball
#
# Returns: 0 on success
# Exits:   1 on extraction failure
# Side effects: creates .stage.$$ under RELEASES_DIR and extracts into it
##
extract_bundle() {
    _bp="$1"

    # CONTRACT section 6 step 4: extract into releases/.stage.$$, validate,
    # then rename into place.
    #
    # This used to derive the release directory from the uploaded filename and
    # extract straight into it. Two things went wrong with that. A half-written
    # release was briefly visible in the releases tree under its final name.
    # Worse, deploy_to_hmi.sh names its tarball <name>-<version>.tar.gz, so
    # redeploying the same version resolved to the directory `current` already
    # pointed at -- and the "remove a stale staging dir" step below then
    # deleted the release the panel was running, before save_previous recorded
    # that same directory as the rollback target. A failed deploy would then
    # "roll back" onto the release it had just destroyed.
    #
    # $$ is this shell's pid, so concurrent installs cannot collide; the flock
    # already serialises them, and this makes the isolation structural.
    STAGING_DIR="${RELEASES_DIR}/.stage.$$"

    # A previous run killed between extract and promote can leave this behind.
    # It is named after a pid that is no longer us, so removing it is safe --
    # unlike removing a directory that `current` might point at.
    if [ -d "$STAGING_DIR" ]; then
        log "WARN" "removing stale staging directory: ${STAGING_DIR}"
        rm -rf "$STAGING_DIR"
    fi

    mkdir -p "$STAGING_DIR"

    # Extract.  --strip-components=0 is the default but stated
    # explicitly for clarity: the tarball's internal structure is
    # preserved as-is under STAGING_DIR.
    if ! tar -xzf "$_bp" -C "$STAGING_DIR"; then
        rm -rf "$STAGING_DIR"
        die 1 "extract" "tar extraction failed for ${_bp}"
    fi

    step "extract" "ok" "${STAGING_DIR}"
}

##
# promote_staging -- rename the validated staging dir to its release id
#
# Reads the application name from the validated manifest and builds the
# CONTRACT section 3 release id: <name>-<UTC yyyymmddTHHMMSSZ>.  The timestamp
# is what makes the id unique, so redeploying the same version produces a new
# directory instead of overwriting the running one.
#
# Sets the global RELEASE_DIR and leaves STAGING_DIR pointing at it.
#
# Args:   none (reads STAGING_DIR)
# Returns: 0 on success
# Exits:   1 if the rename fails
# Side effects: renames the staging directory
##
promote_staging() {
    _name=$("$PYTHON" -c "
import json, sys
with open(sys.argv[1]) as f:
    print(json.load(f)['name'])
" "${STAGING_DIR}/manifest.json")

    _stamp=$("$PYTHON" -c "
import datetime
print(datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ'))
")

    RELEASE_DIR="${RELEASES_DIR}/${_name}-${_stamp}"

    # A same-second redeploy would otherwise collide. Rare, but the whole point
    # of this function is that a release id is never reused.
    _suffix=1
    while [ -e "$RELEASE_DIR" ]; do
        RELEASE_DIR="${RELEASES_DIR}/${_name}-${_stamp}.${_suffix}"
        _suffix=$(( _suffix + 1 ))
    done

    if ! mv "$STAGING_DIR" "$RELEASE_DIR"; then
        rm -rf "$STAGING_DIR"
        die 1 "promote" "could not rename staging dir to ${RELEASE_DIR}"
    fi

    STAGING_DIR="$RELEASE_DIR"
    step "promote" "ok" "${RELEASE_DIR}"
}

##
# validate_manifest -- validate the staged bundle per CONTRACT section 4
#
# Delegates to schema/manifest.py, the single implementation of the manifest
# rules that the host CLI and the desktop tool also call.
#
# The rules used to be a third copy, embedded in this file as a heredoc. It
# disagreed with the other two in both directions -- it required a 'version'
# the desktop tool never checked, and knew nothing about the 'runtime'/'entry'
# agreement CONTRACT 4.1 requires everywhere -- so a bundle could install from
# one tool and be refused by another. The target still validates independently
# of the host, which is what CONTRACT section 4 asks for; it just no longer
# validates by different rules.
#
# The archive-traversal check that used to live here has moved to
# prescan_bundle, which runs BEFORE extraction. Walking the staging directory
# for ".." after extracting could never detect an escape: a member that escaped
# is by definition not in the tree being walked.
#
# Args:   none (reads STAGING_DIR global)
# Returns: 0 if the bundle is valid
# Exits:   1 with the validator's own message on any failure
# Side effects: none
##
validate_manifest() {
    if [ ! -f "${STAGING_DIR}/manifest.json" ]; then
        die 1 "validate-manifest" "manifest.json not found in ${STAGING_DIR}"
    fi

    if [ ! -f "$VALIDATOR" ]; then
        die 1 "validate-manifest" "manifest validator not found at ${VALIDATOR}"
    fi

    # `|| true` so `set -e` does not kill the script the moment the validator
    # exits non-zero: the whole point of capturing its output is to report the
    # reason through die().
    _result=$("$PYTHON" "$VALIDATOR" "$STAGING_DIR" 2>&1) || true

    if [ "$_result" != "OK" ]; then
        die 1 "validate-manifest" "$_result"
    fi

    step "validate-manifest" "ok" "${STAGING_DIR}/manifest.json"
}

##
# swap_current_symlink -- atomically replace the `current` symlink
#
# CRITICAL: This function uses python3 os.replace() on a temporary
# symlink to achieve atomic swap.  The alternatives are worse:
#
#   ln -sfnT <target> <link>
#     -- busybox coreutils on some Yocto images lack the -T flag.
#        Without -T, ln -sf follows an existing symlink and creates
#        a nested link inside the target directory instead of
#        replacing the symlink itself.  This is a silent data
#        corruption bug.
#
#   rm <link> && ln -s <target> <link>
#     -- leaves a window (however brief) where the symlink does not
#        exist.  If the GUI or any monitoring tool reads `current`
#        during that window, the panel has no UI.  On a busy system
#        under I/O pressure the window can be hundreds of milliseconds.
#
#   mv -T <tmp_link> <link>
#     -- busybox mv also lacks -T on some images.
#
# The python3 os.replace() approach:
#   1. Create a temporary symlink next to `current` (same filesystem,
#      guaranteed by being in the same directory).
#   2. os.replace() the temp symlink onto `current`.  On Linux this is
#      a single rename(2) syscall which is atomic within a directory
#      on any POSIX filesystem.
#   3. If step 2 fails, remove the temp symlink and exit non-zero.
#
# Args:
#   $1  target_dir  -- absolute path to the release directory
#
# Returns: 0 on success
# Exits:   1 on failure
# Side effects: replaces CURRENT_LINK; creates/removes temp symlink
##
swap_current_symlink() {
    _target="$1"

    # `if ! cmd` rather than `cmd` followed by `[ $? -ne 0 ]`: this script runs
    # under `set -e`, so a failing python exited the shell before the status
    # check could ever run. The die below was unreachable, and a failed swap
    # aborted the install with no STEP fail line and no rollback.
    if ! "$PYTHON" -c "
import os, sys, tempfile

target = sys.argv[1]
link   = sys.argv[2]
link_dir = os.path.dirname(link)

# Create a temporary symlink in the same directory as 'current' so
# os.replace() is a same-directory rename (atomic on POSIX).
fd, tmp = tempfile.mkstemp(dir=link_dir, prefix='.current_swap_')
os.close(fd)
os.unlink(tmp)           # mkstemp creates a regular file; remove it
os.symlink(target, tmp)  # create the temp symlink

try:
    os.replace(tmp, link)  # atomic rename(2)
except Exception as e:
    # Clean up the temp symlink on failure.
    try:
        os.unlink(tmp)
    except OSError:
        pass
    print(f'atomic symlink swap failed: {e}', file=sys.stderr)
    sys.exit(1)
" "$_target" "$CURRENT_LINK"; then
        die 1 "swap-symlink" "failed to atomically swap current symlink to ${_target}"
    fi

    step "swap-symlink" "ok" "current -> ${_target}"
}

##
# save_previous -- record the current release as `previous` before swap
#
# Reads the current symlink target and creates/replaces the `previous`
# symlink to point at it.  If there is no current symlink (first ever
# install), this is a no-op.
#
# Args:   none
# Returns: 0
# Exits:   never
# Side effects: creates or replaces PREVIOUS_LINK
##
save_previous() {
    if [ -L "$CURRENT_LINK" ]; then
        _prev_target=$(readlink "$CURRENT_LINK")
        # Use the same atomic swap technique for the previous symlink.
        #
        # The exception handler here used to swallow the failure and fall off
        # the end with status 0, so a `previous` symlink that could not be
        # written was still reported as "ok". The rollback target then stayed
        # pointing at a release from two deploys ago, and nothing said so.
        if ! "$PYTHON" -c "
import os, sys, tempfile
target = sys.argv[1]
link   = sys.argv[2]
link_dir = os.path.dirname(link)
fd, tmp = tempfile.mkstemp(dir=link_dir, prefix='.prev_swap_')
os.close(fd)
os.unlink(tmp)
os.symlink(target, tmp)
try:
    os.replace(tmp, link)
except Exception as e:
    try: os.unlink(tmp)
    except OSError: pass
    print('previous symlink swap failed: %s' % e, file=sys.stderr)
    sys.exit(1)
" "$_prev_target" "$PREVIOUS_LINK"; then
            die 1 "save-previous" "could not record ${_prev_target} as the rollback target"
        fi
        step "save-previous" "ok" "previous -> ${_prev_target}"
    else
        step "save-previous" "ok" "no previous release (first install)"
    fi
}

##
# restart_gui -- restart the GUI service and wait for readiness
#
# Removes the gui-ready sentinel, restarts the GUI via the configured
# restart command, then polls for the sentinel to reappear within
# GUI_READY_TIMEOUT seconds.
#
# If HMI_SKIP_GUI_WAIT is "1", the restart and wait are skipped entirely.
# This is used for off-target testing where systemd is not available.
#
# Args:   none
# Returns:
#   0 if the GUI came up within the timeout (or wait was skipped)
#   1 if the GUI did not come up
# Exits:   never
# Side effects: restarts the GUI service; removes/checks READY_FILE
##
restart_gui() {
    if [ "$HMI_SKIP_GUI_WAIT" = "1" ]; then
        step "restart-gui" "ok" "skipped (HMI_SKIP_GUI_WAIT=1)"
        return 0
    fi

    # Remove the readiness sentinel so we can detect when the new
    # instance creates it.
    rm -f "$READY_FILE"

    log "INFO" "restarting GUI via: ${HMI_RESTART_CMD}"
    # 9>&- closes the flock file descriptor for the child. Without it the GUI
    # process inherits FD 9 and, because it is meant to run forever, holds the
    # install lock forever: every later install and rollback dies with "another
    # hmi-install is already running" until the panel is rebooted. Under systemd
    # the restart is a D-Bus call and PID 1 spawns the service with clean
    # descriptors, which hides this -- but HMI_RESTART_CMD is documented as
    # overridable, and any override that forks the GUI directly hits it.
    if ! eval "$HMI_RESTART_CMD" 9>&-; then
        step "restart-gui" "fail" "restart command failed"
        return 1
    fi

    # Poll for the readiness sentinel.
    _elapsed=0
    while [ "$_elapsed" -lt "$GUI_READY_TIMEOUT" ]; do
        if [ -f "$READY_FILE" ]; then
            step "restart-gui" "ok" "GUI ready after ${_elapsed}s"
            return 0
        fi
        sleep 1
        _elapsed=$(( _elapsed + 1 ))
    done

    step "restart-gui" "fail" "GUI did not become ready within ${GUI_READY_TIMEOUT}s"
    return 1
}

##
# enable_boot -- make the deployed application start at power-on
#
# Installing a release sets `current` and restarts the GUI, which covers
# "running now".  It does not cover "running after the next boot": that needs
# hmi-gui.service to be enabled, and on a panel where it never was, the
# operator sees a working HMI that comes up blank the next morning.
#
# The symlink itself is already persistent -- it lives on flash -- so enabling
# the unit is the only missing piece.  Enabling hmi-gui.service also pulls in
# weston.service at boot through the unit's Requires=, so the whole display
# chain follows from this one call.
#
# Failure here is reported but does NOT fail the install.  The new release is
# at that point installed, running and verified; tearing it down because the
# panel could not be made to autostart would replace a working UI with an old
# one, which is worse than the problem.  The step line is how the host tools
# surface it.
#
# Args:   none
# Returns: 0 if the unit was enabled (or the step was skipped), 1 otherwise
# Exits:   never
# Side effects: runs HMI_ENABLE_CMD
##
enable_boot() {
    if [ "$HMI_SKIP_GUI_WAIT" = "1" ]; then
        step "enable-boot" "ok" "skipped (HMI_SKIP_GUI_WAIT=1)"
        return 0
    fi

    log "INFO" "enabling GUI at boot via: ${HMI_ENABLE_CMD}"
    # 9>&- for the same reason as restart_gui: never leak the install lock.
    if eval "$HMI_ENABLE_CMD" 9>&- >/dev/null 2>&1; then
        step "enable-boot" "ok" "hmi-gui.service will start at boot"
        return 0
    fi

    step "enable-boot" "fail" "could not enable hmi-gui.service; the app runs now but will NOT start after a reboot"
    log "WARN" "autostart could not be configured -- run '${HMI_ENABLE_CMD}' on the panel"
    return 1
}

##
# rollback_to_previous -- restore the previous release after a failed deploy
#
# Reads the `previous` symlink and swaps `current` back to it.
# Then restarts the GUI (best-effort; if this also fails, the operator
# must intervene manually).
#
# Args:   none
# Returns: 0 on success, 1 if no previous release exists
# Exits:   never (caller decides whether to exit)
# Side effects: replaces CURRENT_LINK; restarts GUI
##
rollback_to_previous() {
    if [ ! -L "$PREVIOUS_LINK" ]; then
        step "rollback" "fail" "no previous release to roll back to"
        return 1
    fi

    _prev_target=$(readlink "$PREVIOUS_LINK")
    log "INFO" "rolling back current -> ${_prev_target}"
    swap_current_symlink "$_prev_target"

    step "rollback" "ok" "current -> ${_prev_target}"

    # Best-effort restart after rollback.
    if [ "$HMI_SKIP_GUI_WAIT" != "1" ]; then
        rm -f "$READY_FILE"
        # 9>&- as in restart_gui: never let the GUI inherit the install lock.
        eval "$HMI_RESTART_CMD" 9>&- || true
    fi

    return 0
}

##
# prune_releases -- remove old releases beyond the retention policy
#
# Keeps the KEEP_RELEASES newest releases (by directory mtime) plus
# whatever `current` and `previous` point at (even if they are older
# than the newest KEEP_RELEASES).  Removes everything else.
#
# Args:   none
# Returns: 0
# Exits:   never
# Side effects: deletes directories under RELEASES_DIR
##
prune_releases() {
    if [ ! -d "$RELEASES_DIR" ]; then
        step "prune" "ok" "no releases directory"
        return 0
    fi

    # Resolve current and previous targets to absolute paths so we can
    # protect them from pruning regardless of age.
    _protect_current=""
    _protect_previous=""

    if [ -L "$CURRENT_LINK" ]; then
        _protect_current=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$CURRENT_LINK")
    fi
    if [ -L "$PREVIOUS_LINK" ]; then
        _protect_previous=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$PREVIOUS_LINK")
    fi

    # Build a list of all release directories sorted by mtime (newest
    # first).  We use python3 to get reliable mtime sorting since
    # busybox ls may lack --sort=time or produce inconsistent output.
    _pruned=$("$PYTHON" -c "
import os, sys

releases_dir  = sys.argv[1]
keep_count    = int(sys.argv[2])
protect_set   = set(filter(None, sys.argv[3:]))

if not os.path.isdir(releases_dir):
    sys.exit(0)

# List all immediate subdirectories with their mtime.
entries = []
for name in os.listdir(releases_dir):
    full = os.path.join(releases_dir, name)
    if os.path.isdir(full):
        entries.append((os.path.getmtime(full), full))

# Sort by mtime descending (newest first).
entries.sort(key=lambda e: e[0], reverse=True)

# Keep the newest keep_count plus anything in the protect set.
kept = 0
for mtime, full in entries:
    real = os.path.realpath(full)
    if real in protect_set:
        continue  # always keep, does not count toward keep_count
    if kept < keep_count:
        kept += 1
        continue  # keep as one of the newest
    # This release is beyond retention and not protected: prune it.
    print(full)
" "$RELEASES_DIR" "$KEEP_RELEASES" "$_protect_current" "$_protect_previous")

    _prune_count=0
    if [ -n "$_pruned" ]; then
        echo "$_pruned" | while IFS= read -r _dir; do
            rm -rf "$_dir"
            log "INFO" "pruned old release: ${_dir}"
        done
        _prune_count=$(echo "$_pruned" | wc -l)
    fi

    step "prune" "ok" "removed ${_prune_count} old release(s)"
}

##
# cmd_install -- the `install` subcommand
#
# Full install pipeline: validate, verify, extract, validate manifest,
# save previous, swap symlink, restart GUI, rollback on failure, prune.
#
# Args:
#   $1  bundle_path  -- path to the bundle tarball
#
# Returns: 0 on success
# Exits:   1 on any failure (after rollback attempt)
# Side effects: modifies RELEASES_DIR, CURRENT_LINK, PREVIOUS_LINK;
#               restarts GUI service; cleans UPLOAD_DIR
##
cmd_install() {
    if [ $# -lt 1 ]; then
        die 2 "usage" "usage: hmi-install install <bundle.tar.gz>"
    fi
    _bundle="$1"

    step "install-start" "ok" "bundle=${_bundle}"

    # -- Validate the bundle path is safe ---
    validate_bundle_path "$_bundle"

    # -- Verify checksum ---
    verify_sha256 "$_bundle"

    # -- Reject hostile archive members BEFORE writing any of them ---
    prescan_bundle "$_bundle"

    # -- Extract into a private staging directory ---
    extract_bundle "$_bundle"

    # -- Validate manifest ---
    validate_manifest
    # STAGING_DIR is now set by extract_bundle.

    # -- Rename the staging dir to its unique release id ---
    # Only now, after validation, does anything appear in the releases tree
    # under a name the rest of the system will use.
    promote_staging

    # -- Save current as previous ---
    save_previous

    # -- Atomic symlink swap ---
    swap_current_symlink "$STAGING_DIR"

    # -- Restart GUI and verify ---
    if ! restart_gui; then
        log "ERROR" "GUI failed to start with new release; initiating rollback"
        step "auto-rollback-start" "ok" "GUI did not come up"

        rollback_to_previous

        # Clean up the failed release directory.
        if [ -d "$STAGING_DIR" ]; then
            rm -rf "$STAGING_DIR"
            log "INFO" "removed failed release: ${STAGING_DIR}"
        fi

        cleanup_upload_dir
        die 1 "install-complete" "deployment FAILED -- rolled back to previous release"
    fi

    # -- Make this the application the panel boots into ---
    # Deliberately after the readiness check: only a release that has been
    # proven to render is worth making the boot default.
    enable_boot || true

    # -- Prune old releases ---
    prune_releases

    # -- Clean up upload directory ---
    cleanup_upload_dir

    step "install-complete" "ok" "deployment successful: $(readlink "$CURRENT_LINK")"
}

##
# cmd_rollback -- the `rollback` subcommand
#
# Manually rolls back to the previous release.
#
# Args:   none
# Returns: 0 on success
# Exits:   1 if no previous release exists
# Side effects: modifies CURRENT_LINK; restarts GUI; cleans UPLOAD_DIR
##
cmd_rollback() {
    step "rollback-start" "ok" ""

    if ! rollback_to_previous; then
        cleanup_upload_dir
        die 1 "rollback-complete" "rollback FAILED -- no previous release"
    fi

    cleanup_upload_dir
    step "rollback-complete" "ok" "rolled back to $(readlink "$CURRENT_LINK")"
}

##
# cmd_activate -- the `activate` subcommand
#
# Makes an already-installed release current.  `rollback` reaches exactly
# one release back; the board retains KEEP_RELEASES more than that, and
# without this they can be listed but never returned to.  A regression
# noticed two deploys late had no route home.
#
# The release must already exist under RELEASES_DIR: this never unpacks
# anything, it only re-points `current`.  The outgoing release becomes
# `previous`, so a mistaken activation is itself undoable by `rollback`.
#
# Args:   $1 -- release directory name (not a path)
# Returns: 0
# Exits:   2 on a missing or malformed name, 1 on an unknown release
# Side effects: swaps the current symlink, rewrites previous, restarts the GUI
##
cmd_activate() {
    if [ $# -lt 1 ] || [ -z "${1:-}" ]; then
        die 2 "usage" "usage: hmi-install activate <release-name>"
    fi
    _release="$1"

    # A name, never a path. The argument arrives over SSH, and a release that
    # could contain a slash or `..` would make this a way to point `current`
    # at anything on the filesystem.
    case "$_release" in
        */*|*..*|.*)
            die 2 "activate" "invalid release name: ${_release}"
            ;;
    esac

    _target="${RELEASES_DIR}/${_release}"
    if [ ! -d "$_target" ]; then
        die 1 "activate" "no such release: ${_release}"
    fi

    step "activate-start" "ok" "release=${_release}"

    _current_real=""
    if [ -L "$CURRENT_LINK" ]; then
        _current_real=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$CURRENT_LINK")
    fi
    _target_real=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$_target")

    if [ "$_current_real" = "$_target_real" ]; then
        step "activate-complete" "ok" "${_release} is already current"
        return 0
    fi

    # Recorded before the swap, exactly as an install does, so `rollback`
    # returns to whatever was running before this activation.
    save_previous
    swap_current_symlink "$_target"

    if [ "$HMI_SKIP_GUI_WAIT" != "1" ]; then
        rm -f "$READY_FILE"
        # 9>&- as in restart_gui: never let the GUI inherit the install lock.
        eval "$HMI_RESTART_CMD" 9>&- || true
    fi

    step "activate-complete" "ok" "current -> ${_target}"
}

##
# cmd_list -- the `list` subcommand
#
# Lists all installed releases, marking which is current and which is
# previous.
#
# Args:   none
# Returns: 0
# Exits:   never
# Side effects: writes to stdout
##
cmd_list() {
    if [ ! -d "$RELEASES_DIR" ]; then
        step "list" "ok" "no releases installed"
        return 0
    fi

    _current_real=""
    _previous_real=""
    if [ -L "$CURRENT_LINK" ]; then
        _current_real=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$CURRENT_LINK")
    fi
    if [ -L "$PREVIOUS_LINK" ]; then
        _previous_real=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$PREVIOUS_LINK")
    fi

    for _dir in "$RELEASES_DIR"/*/; do
        # Skip if glob did not expand.
        [ -d "$_dir" ] || continue

        _real=$("$PYTHON" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$_dir")
        _name="${_dir%/}"
        _name="${_name##*/}"
        _marker=""

        if [ "$_real" = "$_current_real" ]; then
            _marker=" [current]"
        fi
        if [ "$_real" = "$_previous_real" ]; then
            _marker="${_marker} [previous]"
        fi

        printf '  %s%s\n' "$_name" "$_marker"
    done

    step "list" "ok" ""
}

##
# cmd_status -- the `status` subcommand
#
# Shows the current and previous release, and whether the GUI is ready.
#
# Args:   none
# Returns: 0
# Exits:   never
# Side effects: writes to stdout
##
cmd_status() {
    if [ -L "$CURRENT_LINK" ]; then
        printf 'current:  %s\n' "$(readlink "$CURRENT_LINK")"
    else
        printf 'current:  (none)\n'
    fi

    if [ -L "$PREVIOUS_LINK" ]; then
        printf 'previous: %s\n' "$(readlink "$PREVIOUS_LINK")"
    else
        printf 'previous: (none)\n'
    fi

    if [ -f "$READY_FILE" ]; then
        printf 'gui:      ready\n'
    else
        printf 'gui:      not ready\n'
    fi

    step "status" "ok" ""
}

##
# cmd_help -- the `help` subcommand
#
# Prints usage information to stdout.
#
# Args:   none
# Returns: 0
# Exits:   never
# Side effects: writes to stdout
##
cmd_help() {
    cat <<'EOF'
hmi-install -- HMI Atomic Bundle Installer

USAGE
  hmi-install install <bundle.tar.gz>   Install a new application bundle
  hmi-install rollback                  Roll back to the previous release
  hmi-install activate <release>        Make an installed release current
  hmi-install list                      List installed releases
  hmi-install status                    Show current/previous release and GUI state
  hmi-install help                      Show this help

ENVIRONMENT
  HMI_ROOT           Path prefix for all filesystem paths (testing only)
  HMI_RESTART_CMD    Override the systemctl restart command (testing)
  HMI_ENABLE_CMD     Override the systemctl enable command (testing)
  HMI_SKIP_GUI_WAIT  Set to "1" to skip GUI restart/wait and autostart (testing)

NOTES
  A successful `install` also enables hmi-gui.service, so the release becomes
  the application the panel starts at boot.  If that step reports "fail" the
  app is running but will not survive a power cycle.

EXIT CODES
  0  Success
  1  Validation or runtime error
  2  Usage error
  3  Lock contention (another install is running)
EOF
}

# ---- Ensure runtime directories exist --------------------------------
# These would normally be created by systemd-tmpfiles at boot, but when
# running off-target with HMI_ROOT set the directories may not exist.
mkdir -p "$RUN_DIR" "$UPLOAD_DIR" "$RELEASES_DIR"

# ---- Serialise concurrent installs with flock(2) ---------------------
# The lock file lives on tmpfs (/run/hmi) so it is automatically cleaned
# on reboot.  We use file descriptor 9 for the lock; it is held for the
# entire duration of the script.

# Open (or create) the lock file on FD 9.
# exec is used to associate the FD with the file without spawning a
# subshell, which would release the lock when it exits.
exec 9>"$LOCK_FILE"

# Attempt a non-blocking exclusive lock.  If another instance holds the
# lock, exit immediately with a clear message rather than queueing.
if ! flock -n 9; then
    die 3 "lock" "another hmi-install is already running (lock: ${LOCK_FILE})"
fi

# ---- Cleanup trap (CONTRACT section 7: "every script: trap cleanup") --
# Installed after the lock so a lock-contention exit does not wipe the upload
# directory out from under the instance that actually holds the lock.
trap cleanup_on_exit EXIT

# ---- Dispatch subcommand ---------------------------------------------

_cmd="${1:-help}"
shift || true

case "$_cmd" in
    install)    cmd_install "$@" ;;
    rollback)   cmd_rollback ;;
    activate)   cmd_activate "$@" ;;
    list)       cmd_list ;;
    status)     cmd_status ;;
    help)       cmd_help ;;
    *)          die 2 "usage" "unknown command: ${_cmd}.  Run 'hmi-install help'." ;;
esac
